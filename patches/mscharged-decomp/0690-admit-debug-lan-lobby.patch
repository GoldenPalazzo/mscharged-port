@@ -1,6 +1,11 @@
 #ifndef _DEBUG_H_
 #define _DEBUG_H_
 
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_DIAGNOSTIC_FRONTEND_LAN)
+#include <cstdarg>
+#include <cstdio>
+#endif
+
 enum eDEBUG_CHANNEL
 {
     DC_STARTUP = 0,
@@ -31,6 +36,18 @@ namespace tDebugPrintManager
 
 inline int Print(eDEBUG_CHANNEL channel, const char* format, ...)
 {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_DIAGNOSTIC_FRONTEND_LAN)
+    // Retail strips debug output. The LAN admission keeps the original network
+    // channel, printed to stderr and so also kept in the session log.
+    if (channel == DC_NETWORK)
+    {
+        va_list args;
+        va_start(args, format);
+        std::fputs("[net] ", stderr);
+        std::vfprintf(stderr, format, args);
+        va_end(args);
+    }
+#endif
     return channel;
 }
 
