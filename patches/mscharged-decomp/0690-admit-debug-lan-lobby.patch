diff --git a/src/Game/NetworkRandomSeed.cpp b/src/Game/NetworkRandomSeed.cpp
index d5d2128..99451e4 100644
--- a/src/Game/NetworkRandomSeed.cpp
+++ b/src/Game/NetworkRandomSeed.cpp
@@ -2,6 +2,106 @@
 
 #include "NL/nlMath.h"
 
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_DIAGNOSTIC_FRONTEND_LAN)
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <dlfcn.h>
+#include <execinfo.h>
+
+// Lockstep needs every machine to draw the same numbers in the same order.
+// MSCHARGED_RNG_TRACE=<file> writes every seed change with the module offsets
+// of its first five callers, so the traces of two machines can be diffed to
+// find the first draw that differs (addr2line -f -C -e <module> <offsets>).
+static FILE* NetworkTraceFile()
+{
+    static FILE* sTrace = 0;
+    static bool sOpened = false;
+    if (!sOpened)
+    {
+        sOpened = true;
+        const char* path = std::getenv("MSCHARGED_RNG_TRACE");
+        if (path != 0 && (sTrace = std::fopen(path, "w")) != 0)
+            std::setvbuf(sTrace, 0, _IOLBF, 0);
+    }
+    return sTrace;
+}
+
+void TraceNetworkFrame(u32 frame)
+{
+    if (FILE* trace = NetworkTraceFile())
+        std::fprintf(trace, "frame %u\n", frame);
+}
+
+// Bit patterns, not decimals: a difference in the last bit must show.
+void TraceNetworkFloats(const char* label, int index, const float* values, int count)
+{
+    FILE* trace = NetworkTraceFile();
+    if (trace == 0)
+        return;
+    std::fprintf(trace, "%s %d", label, index);
+    for (int i = 0; i < count; ++i)
+    {
+        u32 bits;
+        std::memcpy(&bits, &values[i], sizeof(bits));
+        std::fprintf(trace, " %08x", bits);
+    }
+    std::fputc('\n', trace);
+}
+
+// Not inlined, so the stack always starts here and then in the nlRandom
+// wrapper: entry 2 is the code that asked for the number.
+__attribute__((noinline)) void TraceNetworkWords(const char* label, int index, const u32* values, int count)
+{
+    FILE* trace = NetworkTraceFile();
+    if (trace == 0)
+        return;
+    std::fprintf(trace, "%s %d", label, index);
+    for (int i = 0; i < count; ++i)
+        std::fprintf(trace, " %x", values[i]);
+    std::fputc('\n', trace);
+}
+
+// The module offsets of the code that called the caller of this function
+__attribute__((noinline)) void TraceNetworkStack(const char* label)
+{
+    FILE* trace = NetworkTraceFile();
+    if (trace == 0)
+        return;
+    void* frames[12];
+    int count = backtrace(frames, 12);
+    std::fprintf(trace, "%s", label);
+    for (int i = 2; i < count; ++i)
+    {
+        Dl_info info;
+        unsigned long offset = 0;
+        if (dladdr(frames[i], &info) && info.dli_fbase != 0)
+            offset = (unsigned long)((char*)frames[i] - (char*)info.dli_fbase);
+        std::fprintf(trace, " 0x%lx", offset);
+    }
+    std::fputc('\n', trace);
+}
+
+static void TraceNetworkRandom(const char* kind, u32 range, u32 before, u32 after)
+{
+    FILE* sTrace = NetworkTraceFile();
+    if (sTrace == 0)
+        return;
+    void* frames[7];
+    int count = backtrace(frames, 7);
+    std::fprintf(sTrace, "%s %u %08x %08x", kind, range, before, after);
+    for (int i = 2; i < count; ++i)
+    {
+        Dl_info info;
+        unsigned long offset = 0;
+        if (dladdr(frames[i], &info) && info.dli_fbase != 0)
+            offset = (unsigned long)((char*)frames[i] - (char*)info.dli_fbase);
+        std::fprintf(sTrace, " 0x%lx", offset);
+    }
+    std::fputc('\n', sTrace);
+}
+#endif
+
 u32 gNetworkRandomSeed = 0x12345678;
 
 u32 GetNetworkRandomSeed()
@@ -11,6 +111,9 @@ u32 GetNetworkRandomSeed()
 
 void SetNetworkRandomSeed(u32 seed)
 {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_DIAGNOSTIC_FRONTEND_LAN)
+    TraceNetworkRandom("set", 0, gNetworkRandomSeed, seed);
+#endif
     gNetworkRandomSeed = seed;
 }
 
@@ -20,10 +123,24 @@ void OnInputSessionReset()
 
 u32 nlRandom(u32 range)
 {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_DIAGNOSTIC_FRONTEND_LAN)
+    u32 before = gNetworkRandomSeed;
+    u32 value = nlRandom(range, &gNetworkRandomSeed);
+    TraceNetworkRandom("int", range, before, gNetworkRandomSeed);
+    return value;
+#else
     return nlRandom(range, &gNetworkRandomSeed);
+#endif
 }
 
 float nlRandomf(float maximum)
 {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_DIAGNOSTIC_FRONTEND_LAN)
+    u32 before = gNetworkRandomSeed;
+    float value = nlRandomf(maximum, &gNetworkRandomSeed);
+    TraceNetworkRandom("float", 0, before, gNetworkRandomSeed);
+    return value;
+#else
     return nlRandomf(maximum, &gNetworkRandomSeed);
+#endif
 }
