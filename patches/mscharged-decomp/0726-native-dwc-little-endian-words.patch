From: mscharged-port
Subject: Keep DWC's little-endian wire words natively
Upstream-base: 7a6bf165d9f1c5914181c079c7d4bfa7204f3509
Classification: native byte-order compatibility

DWC exchanges little-endian words, the DS's order: match commands over
the server browser, QR2 and GP, the peer transport's headers, and the
words its CRCs cover. The Wii converts with DWCi_HtoLEl, DWCi_HtoLEs,
DWCi_LEtoHl, DWCi_LEtoHs and DWCi_Np_ToLE, which unconditionally byte-swap
because the Wii is big-endian. On a little-endian host they swapped the
words out of that order. Match commands left big-endian, so the server
misread the reservations it inspects and rewrites (it decodes them as
little-endian for every platform); friend keys hashed the swapped words,
so the game showed 4219-0679-5010 for profile 1000000002 where the Wii's
DWC gives 2157-4836-4802; and the user data CRC covered swapped words.

Natively those conversions keep the words as they are, guarded to
little-endian hosts. GP buddy messages print each command word as the
decimal of the u32 the Wii holds, a big-endian load of the word's bytes;
natively that is the byte-swapped load, so DWCi_GPCommandWord swaps on
both sending and parsing to keep the Wii's numbers on the wire.

diff --git a/libs/RVL_SDK/include/dwc/dwc_nonport.h b/libs/RVL_SDK/include/dwc/dwc_nonport.h
index 9b29003..266d6c9 100644
--- a/libs/RVL_SDK/include/dwc/dwc_nonport.h
+++ b/libs/RVL_SDK/include/dwc/dwc_nonport.h
@@ -64,6 +64,23 @@ static inline void DWCi_Np_CpuClear32(void* dest, u32 size)
     memset(dest, 0, size);
 }
 
+#if defined(MSCHARGED_NATIVE)
+// DWC's wire words are little-endian, which the big-endian Wii swaps into.
+// A little-endian host already holds them in that order.
+#if __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
+#error "DWC's native little-endian conversions assume a little-endian host"
+#endif
+
+static inline u16 DWCi_HtoLEs(u16 data)
+{
+    return data;
+}
+
+static inline u32 DWCi_HtoLEl(u32 data)
+{
+    return data;
+}
+#else
 static inline u16 DWCi_HtoLEs(u16 data)
 {
     return (u16)((data >> 8) | (data << 8));
@@ -75,6 +92,7 @@ static inline u32 DWCi_HtoLEl(u32 data)
     tmp = ((data >> 8) & 0x00ff00ff) | ((data << 8) & 0xff00ff00);
     return (tmp >> 16) | (tmp << 16);
 }
+#endif
 
 static inline u16 DWCi_LEtoHs(u16 data)
 {
diff --git a/src/RVL_SDK/dwc/dwc_match.c b/src/RVL_SDK/dwc/dwc_match.c
index 86678c6..cc244ef 100644
--- a/src/RVL_SDK/dwc/dwc_match.c
+++ b/src/RVL_SDK/dwc/dwc_match.c
@@ -19,6 +19,17 @@
 
 #define DWC_MATCH_COMMAND_ADD_MESSAGE_MAX 512
 
+#if defined(MSCHARGED_NATIVE)
+// GP buddy messages carry each command word as the decimal of the u32 the
+// Wii holds, a big-endian load of the word's (little-endian) bytes. Natively
+// the same number is the byte-swapped native load.
+#define DWCi_GPCommandWord(word)                                       \
+    ((((u32)(word) >> 24) & 0x000000FF) | (((u32)(word) >> 8) & 0x0000FF00) \
+        | (((u32)(word) << 8) & 0x00FF0000) | (((u32)(word) << 24) & 0xFF000000))
+#else
+#define DWCi_GPCommandWord(word) (word)
+#endif
+
 enum
 {
     DWC_MATCH_CANCEL_STATE_INIT = 0,
@@ -1674,7 +1685,7 @@ void DWCi_MatchGPRecvBuddyMsgCallback(
         {
             break;
         }
-        list[i] = strtoul(buf, NULL, 10);
+        list[i] = DWCi_GPCommandWord(strtoul(buf, NULL, 10));
     }
     DWCi_ProcessRecvMatchCommand(message[0], profileId, 0, 0, list, i);
 }
@@ -2511,11 +2522,11 @@ static int DWCi_SendMatchCommand(u8 command, int profileID, u32 ip, u16 port,
     {
         if (data && len)
         {
-            msgLen = snprintf(message, sizeof(message), "%u", data[0]);
+            msgLen = snprintf(message, sizeof(message), "%u", DWCi_GPCommandWord(data[0]));
 
             for (i = 1; i < len; i++)
             {
-                tmpLen = snprintf(tmpStr, sizeof(tmpStr), "/%u", data[i]);
+                tmpLen = snprintf(tmpStr, sizeof(tmpStr), "/%u", DWCi_GPCommandWord(data[i]));
                 DWCi_Np_CpuCopy8(
                     tmpStr, &message[msgLen], (u32)tmpLen);
                 msgLen += tmpLen;
