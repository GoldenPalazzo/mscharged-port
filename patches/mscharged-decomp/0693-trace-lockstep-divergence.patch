+            TraceNetworkFloats("vel", team * 5 + i, (const float*)&player->GetVelocity(), 3);
+        }
+    }
+    // Each fielder's AI: active state, its age, the pending state, then the age
+    // of every active concurrent state (ffffffff when inactive)
+    for (int team = 0; team < 2; team++)
+    {
+        for (int i = 0; i < 4; i++)
+        {
+            cFielder* fielder = g_pTeams[team]->GetFielder(i);
+            ScriptMachine* machine = fielder != 0 && fielder->m_pAIContext != 0 ? fielder->m_pAIContext->mScriptMachine : 0;
+            if (machine == 0)
+                continue;
+            u32 words[3 + 32];
+            int count = 0;
+            shdStateMachine* active = machine->mActiveState;
+            words[count++] = active != 0 ? (u32)active->mState : 0xFFFFFFFFu;
+            words[count++] = active != 0 ? active->mAgeTimer.m_uPackedTime : 0;
+            words[count++] = (u32)machine->mPendingState;
+            for (int state = 0; state < machine->mStateCount && count < 3 + 32; state++)
+            {
+                shdStateMachine* concurrent = machine->mConcurrentStates[state];
+                words[count++] = concurrent != 0 && concurrent->IsActive() ? concurrent->mAgeTimer.m_uPackedTime : 0xFFFFFFFFu;
+            }
+            TraceNetworkWords("ai", team * 4 + i, words, count);
+        }
+        // The team's own AI, same layout
+        ScriptMachine* machine = g_pTeams[team]->m_pAIContext != 0 ? g_pTeams[team]->m_pAIContext->mScriptMachine : 0;
+        if (machine != 0)
+        {
+            u32 words[3 + 32];
+            int count = 0;
+            shdStateMachine* active = machine->mActiveState;
+            words[count++] = active != 0 ? (u32)active->mState : 0xFFFFFFFFu;
+            words[count++] = active != 0 ? active->mAgeTimer.m_uPackedTime : 0;
+            words[count++] = (u32)machine->mPendingState;
+            for (int state = 0; state < machine->mStateCount && count < 3 + 32; state++)
+            {
+                shdStateMachine* concurrent = machine->mConcurrentStates[state];
+                words[count++] = concurrent != 0 && concurrent->IsActive() ? concurrent->mAgeTimer.m_uPackedTime : 0xFFFFFFFFu;
+            }
+            TraceNetworkWords("teamai", team, words, count);
+        }
+    }
+    // The synchronized input every machine simulates with, per player
