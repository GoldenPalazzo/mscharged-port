+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_DIAGNOSTIC_LOCKSTEP_TRACE)
+    // The state each simulation step starts from, for the lockstep trace
+    TraceNetworkFrame(gInputManager->mFrameProvider->GetFrame());
+    TraceNetworkFloats("ball", 0, (const float*)&g_pBall->m_v3Position, 3);
+    TraceNetworkFloats("ballv", 0, (const float*)&g_pBall->m_v3Velocity, 3);
