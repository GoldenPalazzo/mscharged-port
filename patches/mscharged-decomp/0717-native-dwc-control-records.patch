+#pragma once
+
+/* Control records of the friend and match units. DWCControl in dwc_main.c
+ * embeds both; natively it needs their actual layout instead of Wii-sized
+ * views, so the three units share these definitions. */
+
+#include <dwc/dwc_datastorage.h>
+#include <dwc/dwc_friend.h>
+#include <dwc/dwc_main.h>
+#include <dwc/dwc_match.h>
