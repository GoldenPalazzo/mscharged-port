+    vu8 qr2IsReserved;
+    u8 qr2ShutdownFlag;
+    u8 pad2;
+    u16 qr2Port;
+    u32 qr2IP;
+    volatile int qr2Reservation;
+    u32 qr2IPList[DWC_MAX_CONNECTIONS];
+    u16 qr2PortList[DWC_MAX_CONNECTIONS];
+    ServerBrowser sbObj;
+    int sbUpdateFlag;
+    u8 _EC[4];
+    s64 sbUpdateTick;
+    int sbPidList[DWC_MAX_CONNECTIONS];
+    s64 sbUpdateRequestTick;
+    u8 nnRecvCount;
+    u8 nnFailureCount;
+    u16 nnCookieRand;
+    int nnLastCookie;
+    s64 nnFailedTime;
+    s64 nnFinishTime;
+    DWCNNInfo nnInfo;
+    DWCMatchState state;
+    u8 clLinkProgress;
+    u8 friendCount;
+    u8 distantFriend;
+    u8 resvWaitCount;
+    u8 closeState;
+    u8 cancelState;
+    u8 scResvRetryCount;
+    u8 synResendCount;
+    u8 cancelSynResendCount;
+    u8 clWaitTimeoutCount;
+    u8 stopSCFlag;
+    u8 pad3;
+    u16 baseLatency;
