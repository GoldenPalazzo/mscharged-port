+// number, and each read the game starts from one, with where it goes.
+void mscharged_rollback_file_opened(const char* path, long entry);
+void mscharged_rollback_read_started(long entry, const void* buffer, unsigned long bytes);
+#endif
 // The inputs applied for the step about to run.
