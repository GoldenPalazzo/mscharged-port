+#if defined(MSCHARGED_TWEAKS)
+// One fixed step again for the rollback, with the inputs the router applied
+// when it first ran: no pads, no capture, nothing sent. A replay restarts
+// after a step, so first comes what the tasks after the previous step did
+// in its frame (particles, front end, events), then what the tasks before
+// this step did in this one, as Run's task order has them.
+static int RollbackReplayStep(const MschargedRollbackInputs* inputs)
+{
