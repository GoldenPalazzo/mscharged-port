+// Run's and DrawFrontEndElements' updates of the presentation, HUD, scenes,
+// lighting, front end models and stadium, without the pads (FEInput), resets,
+// resource loading, drawing, the resource pool inventory (left out of the
+// rollback with its pool) or the uptime.
+void RollbackReplayFrontEnd(float dt)
+{
+    FrontEndPresentation::GetInstance()->Update(dt);
+#if !defined(MSCHARGED_DIAGNOSTIC_FRONTEND_TASK_CADENCE) || defined(MSCHARGED_DIAGNOSTIC_FRONTEND_WORLD_DRAW)
+    UpdateGameObjectLighting();
+#endif
+#if !defined(MSCHARGED_DIAGNOSTIC_FRONTEND_TASK_CADENCE) \
+    || (defined(MSCHARGED_NATIVE) && defined(MSCHARGED_DIAGNOSTIC_FRONTEND_MATCH_LOADING))
+    if ((nlTaskManager::m_pInstance->mCurrentState & 0x1b) && !IsHBMActive())
+    {
+        FrontEnd::Update(dt);
+    }
+#endif
+    if (FEResourceManager::Instance() != 0 && !IsHBMActive())
+    {
+        FESceneManager::Instance()->Update(dt);
+    }
+#if !defined(MSCHARGED_DIAGNOSTIC_FRONTEND_TASK_CADENCE) || defined(MSCHARGED_DIAGNOSTIC_FRONTEND_FE_MODELS)
+    if (FEModelManager::Instance() != 0 && !IsHBMActive())
+    {
+        FEModelManager::Instance()->Update(dt);
+    }
+#endif
+#if !defined(MSCHARGED_DIAGNOSTIC_FRONTEND_TASK_CADENCE) || defined(MSCHARGED_DIAGNOSTIC_FRONTEND_WORLD_DRAW)
+    if (nlTaskManager::m_pInstance->mCurrentState == 4 && IsStadiumWorldLoaded() && !IsHBMActive())
+    {
+        UpdateStadium(dt);
+    }
+#endif
+}
+#endif
diff --git a/src/Game/Task/GameRenderTask.cpp b/src/Game/Task/GameRenderTask.cpp
index 5a03a53..eaa024d 100644
--- a/src/Game/Task/GameRenderTask.cpp
+++ b/src/Game/Task/GameRenderTask.cpp
@@ -573,4 +573,74 @@ bool IsWarbleParticleRenderingEnabled()
 {
     return sWarbleParticleRenderingEnabled;
 }
+#if defined(MSCHARGED_TWEAKS)
+#include "mscharged_rollback.h"
+#include "Game/RenderSnapshot_fwd.h"
+
+// Run's and RenderFrame's updates of the match's presentation, in their
+// order, for a rollback's replay: what both update and draw draws nothing
+// (GLView drops it). The impostors, the world's models and the replay
+// snapshot are drawn afresh every frame; the blur's update draws its meshes
+// into frame memory as it goes; a secondary NIS stops rollbacks.
+void RollbackReplayGameRender(float fDeltaT)
+{
+    if (gpHBMManager != 0 && gpHBMManager->mActive && gpHBMManager->mReady)
+    {
+        return;
+    }
+    if (TimedObjectManager::Instance() != 0)
+    {
+        TimedObjectManager::Instance()->Update(fDeltaT);
+    }
+    if (NisPlayer::Instance()->HasSecondaryNis() || !g_bRenderWorld)
+    {
+        return;
+    }
+
+    if (GetFixedUpdateTask()->mfFrameLockTime > 0.0f)
+    {
+        FixedUpdateTask::DecrementFrameLock(fDeltaT);
+    }
+
+    float dt = (nlTaskManager::m_pInstance->mCurrentState == TASK_PAUSED) ? 0.0f : fDeltaT;
+    UpdateWarble(&gWarble, dt);
+    UpdateAttackSideIndicators();
+    for (int charIndex = 0; charIndex < 10; charIndex++)
+    {
+        if (g_pCharacters[charIndex] != 0)
+        {
+            g_pCharacters[charIndex]->UpdateBlinking(dt);
+        }
+    }
 
+    // RenderSnapshot::Render's timer.
+    if (nlTaskManager::m_pInstance->mCurrentState != TASK_FRONTEND && g_AllActorsHidden > 0.0f)
+    {
+        g_AllActorsHidden -= fDeltaT;
+    }
+
+    u32 currState = nlTaskManager::m_pInstance->mCurrentState;
+    if (currState == TASK_GAMEPLAY
+        || (currState == TASK_PAUSED && nlTaskManager::m_pInstance->mPreviousState == TASK_GAMEPLAY))
+    {
+        float indicatorDt = (currState == TASK_GAMEPLAY) ? fDeltaT : 0.0f;
+        if (g_pGame->mbCaptainShotToScoreOn)
+        {
+            UpdateAndRenderMegaBallIndicators(indicatorDt);
+        }
+        else
+        {
+            UpdateAndRenderIndicators(indicatorDt);
+        }
+        ShootToScoreMeter::instance.UpdateAndRender(fDeltaT);
+        gMegastrikeBackgroundOverlay.UpdateAndRender(fDeltaT);
+    }
+
+    WorldDarkening::Instance().Update(fDeltaT);
+    if (g_bRenderWorldEffects)
+    {
+        PhotoFlash::Render(fDeltaT);
+        UpdateElectricFence(fDeltaT);
+    }
+}
+#endif
