+// Rollback: the frame memory, used afresh every frame with its cursors in this
+// file's statics, which a rollback leaves alone with it.
+extern "C" int mscharged_rollback_frame_memory(const void** pointers, int capacity)
+{
+    int count = 0;
+    for (int pool = 0; pool < 2 && count < capacity; ++pool)
+    {
+        pointers[count++] = (const void*)sFrameMemory[0][pool];
+    }
+    return count;
+}
+
+// The end of a frame a rollback replays: the next one uses this frame's memory
+// afresh, as glplatFrameAllocNextFrame lets a frame do, but in the same half,
+// since the other may still be read for the frame sent before.
+extern "C" void mscharged_rollback_reuse_frame_memory(void)
+{
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE) && !defined(MSCHARGED_DIAGNOSTIC_RESOURCE_POOLS)
+    mscharged::platform::GameGraphicsRetirementReservation nativeRetirement[2];
+#endif
+    for (int pool = 0; pool < 2; ++pool)
+    {
+        sFrameMemoryUsed[sCurrentFrame][pool] = 0;
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE) && !defined(MSCHARGED_DIAGNOSTIC_RESOURCE_POOLS)
+        nativeRetirement[pool].Commit((void*)sFrameMemory[sCurrentFrame][pool], sFrameMemorySizes[pool]);
+#endif
+    }
+}
+#endif
