diff --git a/include/mscharged_rollback.h b/include/mscharged_rollback.h
new file mode 100644
index 0000000..067ae2c
--- /dev/null
+++ b/include/mscharged_rollback.h
@@ -0,0 +1,67 @@
+#if defined(MSCHARGED_TWEAKS)
+#ifndef MSCHARGED_ROLLBACK_H
+#define MSCHARGED_ROLLBACK_H
+
+// Rollback of the native port (src/platform/rollback_test.cpp in the game
+// module). It does nothing unless RECHARGED_ROLLBACK_TEST is set.
+
+#define MSCHARGED_ROLLBACK_MAX_EVENTS 16
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// What the input router applied before one fixed step: every machine's
+// players' packed inputs and the deterministic data events it queued for the
+// simulation, in the order it did both.
+struct MschargedRollbackInputs
+{
+    int machineCount;
+    signed char machines[4];         // in the order applied
+    unsigned char players[4];        // by machine
+    unsigned short remapAngles[4];   // by machine
+    unsigned char records[16][16];   // PackedDetInput, by network player id
+    unsigned char states[16];        // connection state, by network player id
+    int eventCount;
+    signed char eventMachines[MSCHARGED_ROLLBACK_MAX_EVENTS];
+    unsigned char events[MSCHARGED_ROLLBACK_MAX_EVENTS][0x24]; // DetermDataEvent
+    int overflowed;                  // more events than MSCHARGED_ROLLBACK_MAX_EVENTS
+    // Filled in by the port for a replay: the time step of the tasks in the
+    // frame of the step before this one, and in this step's frame.
+    float previousFrameTime;
+    float frameTime;
+};
+
+// Whether the rollback runs: the routers then report the inputs they apply,
+// and deterministic data on its way out stays outside the game's arenas.
+bool mscharged_rollback_active(void);
+// Whether the steps running now replay earlier ones: deterministic data they
+// queue was sent when they first ran.
+bool mscharged_rollback_resimulating(void);
+// The inputs applied for the step about to run.
+void mscharged_rollback_inputs_applied(const struct MschargedRollbackInputs* inputs);
+// Between two fixed steps of a match, where the rollback saves the match and
+// may go back: `replay` runs one step again with the inputs it was given
+// (1, or -1 when a NIS now stops the simulation), `checksum` is the game's
+// checksum, `task` and `taskBytes` the fixed update task.
+void mscharged_rollback_between_steps(int (*replay)(const struct MschargedRollbackInputs* inputs),
+                                      unsigned (*checksum)(void), void* task, unsigned long taskBytes);
+// The game's: pointers into the drawing's memory (the frame memory, every
+// resource pool and its memory), at most capacity; returns how many.
+int mscharged_rollback_graphics_memory(const void** pointers, int capacity);
+
+#ifdef __cplusplus
+}
+
+// A replayed frame also runs, around its step, what the frame's other tasks
+// do to the match's state and presentation, without drawing, reading pads or
+// files, sending or making sounds: BeginFrameTask's presentation, NIS,
+// characters' mega blend and cameras; the particles' update; the front end's
+// presentation, HUD and scenes.
+void RollbackReplayBeginFrame(float dt);
+void RollbackReplayParticles(float dt);
+void RollbackReplayFrontEnd(float dt);
+#endif
+
+#endif // MSCHARGED_ROLLBACK_H
+#endif // MSCHARGED_TWEAKS
