diff --git a/include/mscharged_rollback.h b/include/mscharged_rollback.h
new file mode 100644
index 0000000..59d14be
--- /dev/null
+++ b/include/mscharged_rollback.h
@@ -0,0 +1,127 @@
+#if defined(MSCHARGED_TWEAKS)
+#ifndef MSCHARGED_ROLLBACK_H
+#define MSCHARGED_ROLLBACK_H
+
+// Rollback of the native port (src/platform/rollback_test.cpp in the game
+// module). It does nothing unless RECHARGED_ROLLBACK_TEST (a test that rolls
+// matches back with the inputs they had) or RECHARGED_ROLLBACK (network
+// matches that predict the inputs still on their way) is set.
+
+#define MSCHARGED_ROLLBACK_MAX_EVENTS 16
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// What the input router applied before one fixed step: every machine's
+// players' packed inputs and the deterministic data events it queued for the
+// simulation, in the order it did both.
+struct MschargedRollbackInputs
+{
+    int machineCount;
+    signed char machines[4];         // in the order applied
+    unsigned char players[4];        // by machine
+    unsigned short remapAngles[4];   // by machine
+    unsigned char records[16][16];   // PackedDetInput, by network player id
+    unsigned char states[16];        // connection state, by network player id
+    int eventCount;
+    signed char eventMachines[MSCHARGED_ROLLBACK_MAX_EVENTS];
+    unsigned char events[MSCHARGED_ROLLBACK_MAX_EVENTS][0x24]; // DetermDataEvent
+    int overflowed;                  // more events than MSCHARGED_ROLLBACK_MAX_EVENTS
+};
+
+// Whether the rollback runs: the routers then report the inputs they apply,
+// and deterministic data on its way out stays outside the game's arenas.
+bool mscharged_rollback_active(void);
+// Whether the steps running now replay earlier ones: deterministic data they
+// queue was sent when they first ran.
+bool mscharged_rollback_resimulating(void);
+// The inputs applied for the step about to run.
+void mscharged_rollback_inputs_applied(const struct MschargedRollbackInputs* inputs);
+// Between two fixed steps of a match, where the rollback saves the match and
+// decides whether to go back: `replay` runs one step again with the inputs it
+// was given (1, or -1 when a NIS now stops the simulation), `checksum` is the
+// game's checksum, `task` and `taskBytes` the fixed update task.
+void mscharged_rollback_between_steps(int (*replay)(const struct MschargedRollbackInputs* inputs),
+                                      unsigned (*checksum)(void), void* task, unsigned long taskBytes);
+// The presses of a mega strike meter received from the shooter's machine,
+// outside the inputs: the steps that use them run again with them.
+void mscharged_rollback_meter_received(const bool* values, int count);
+// Every task the task manager runs, with its time step: a rollback replays
+// whole frames, each task with the time step it had.
+void mscharged_rollback_task_time(const void* task, float dt);
+// At the start of a frame, before any task sets up its cameras and views:
+// where the rollback goes back and replays, through the end of the last frame.
+void mscharged_rollback_frame_start(void);
+// Network matches with rollback: the network router lets the port decide
+// whether a step can run and apply its inputs, predicting those of machines
+// whose inputs have not arrived (a later frame goes back when they differ).
+bool mscharged_rollback_predicting(void);
+// At the router's reset for a match: the steps of input delay every machine
+// uses (the router's queue limit, fixed while the match lasts).
+int mscharged_rollback_network_reset(void);
+// Whether the next step can run, in place of the router's queues.
+bool mscharged_rollback_has_input(void);
+// Applies the next step's inputs, in place of the router.
+void mscharged_rollback_input_ready(void);
+// Whether the local inputs are still to be captured and sent for this step:
+// a step undone and run again sent them the first time, and a capture left
+// out shortens this machine's input delay by a step.
+bool mscharged_rollback_can_capture(void);
+// After a capture: how many more messages to send with the same inputs, each
+// lengthening this machine's input delay by a step.
+int mscharged_rollback_extra_captures(void);
+// What an outgoing input message carries besides the inputs: 1, sync data
+// (the last step whose inputs all arrived, with its checksum and random
+// seed); 2, a frame word only (`frame`: how far ahead of this machine the
+// others' inputs come, for the time sync); 0, neither.
+int mscharged_rollback_sync_data(unsigned* checksum, unsigned* frame, unsigned* seed);
+// The audio: under the rollback its state lives in a heap of its own, which no
+// rollback restores, as the sound it describes goes on. The functions the game
+// calls into the audio enter and leave it (MSCHARGED_AUDIO_SCOPE); inside,
+// mscharged_rollback_audio_allocator is the allocator every allocation uses,
+// null outside or without the rollback.
+void mscharged_rollback_audio_enter(void);
+void mscharged_rollback_audio_leave(void);
+void* mscharged_rollback_audio_allocator(void);
+// The game's: pointers into the frame memory blocks, at most capacity;
+// returns how many.
+int mscharged_rollback_frame_memory(const void** pointers, int capacity);
+// The game's: the disc reads' manager and its tail buffers, which go on
+// whatever the match does (a rollback must not take back a read under way,
+// as the audio's streams have); returns how many pointers, at most capacity.
+int mscharged_rollback_async_read_state(const void** pointers, int capacity);
+// The game's: the end of a replayed frame, whose frame memory the next one
+// uses afresh.
+void mscharged_rollback_reuse_frame_memory(void);
+
+#ifdef __cplusplus
+}
+
+// A rollback replays whole frames: their tasks run as they did (drawing with
+// nowhere to go, GLView drops it), but for the pads, sound, network, disc and
+// movies, and for these, which do a replayed frame's part of their task:
+// FixedUpdateTask's work before its steps, and EndFrameTask's end of a frame
+// without sending it.
+void RollbackReplayFixedFrame(float dt);
+void RollbackReplayEndFrame();
+// Gives the match the mega strike meter presses received before a step again.
+void RollbackRedeliverMegaStrikeMeter(const bool* values, int count);
+
+struct MschargedAudioScope
+{
+    MschargedAudioScope() { mscharged_rollback_audio_enter(); }
+    ~MschargedAudioScope() { mscharged_rollback_audio_leave(); }
+};
+// At the start of an audio function the game calls: its allocations go to the
+// audio's heap.
+#define MSCHARGED_AUDIO_SCOPE() MschargedAudioScope mschargedAudioScope
+// At the start of one that starts, stops, pauses or resumes sound: a replayed
+// frame does nothing (it did it when it first ran) and returns the value given.
+#define MSCHARGED_AUDIO_ACTION(...)                                                                  \
+    if (mscharged_rollback_resimulating()) return __VA_ARGS__;                                       \
+    MSCHARGED_AUDIO_SCOPE()
+#endif
+
+#endif // MSCHARGED_ROLLBACK_H
+#endif // MSCHARGED_TWEAKS
