+#if defined(MSCHARGED_TWEAKS)
+// Rollback: what the router applies before each step, reported to the port so
+// that a rollback can replay it (ApplyRollbackInputs).
+typedef char VerifyRollbackRecordSize[(sizeof(PackedDetInput) == 16) ? 1 : -1];
+typedef char VerifyRollbackEventSize[(sizeof(DetermDataEvent) == 0x24) ? 1 : -1];
+static MschargedRollbackInputs sRollbackInputs;
+
+static void BeginRollbackInputs()
+{
+    sRollbackInputs.machineCount = 0;
+    sRollbackInputs.eventCount = 0;
+    sRollbackInputs.overflowed = 0;
+}
+
+static void RecordRollbackEvent(s8 machine, const DetermDataEvent* event)
+{
+    if (sRollbackInputs.eventCount == MSCHARGED_ROLLBACK_MAX_EVENTS)
+    {
+        sRollbackInputs.overflowed = 1;
+        return;
+    }
+    sRollbackInputs.eventMachines[sRollbackInputs.eventCount] = machine;
+    memcpy(sRollbackInputs.events[sRollbackInputs.eventCount++], event, sizeof(DetermDataEvent));
+}
+
+static void RecordRollbackMachine(InputRouter* router, s8 machine, NetworkPeer* peer)
+{
+    sRollbackInputs.machines[sRollbackInputs.machineCount++] = machine;
+    sRollbackInputs.players[machine] = (u8)peer->mPlayerCount;
+    sRollbackInputs.remapAngles[machine] = router->mRemapAngles[machine];
+    for (s8 player = 0; player < (int)peer->mPlayerCount; ++player)
+    {
+        s8 playerId = GetNetworkPlayerId(player, machine);
+        memcpy(sRollbackInputs.records[playerId], &router->mInputRecords[playerId], sizeof(PackedDetInput));
+        sRollbackInputs.states[playerId] = router->mInputStates[playerId];
+    }
+}
+
+// Deterministic data on its way out lives outside the game's arenas while the
+// rollback runs: a rollback restores the arenas, not the router's queue.
+static void FreeOutgoingDetermData(DetermDataEvent* event)
+{
+    if (mscharged_rollback_active())
+    {
+        event->~DetermDataEvent();
+        free(event);
+    }
+    else
+    {
+        delete event;
+    }
+}
+
+void ApplyRollbackInputs(const MschargedRollbackInputs* inputs)
+{
+    int event = 0;
+    for (int index = 0; index < inputs->machineCount; ++index)
+    {
+        s8 machine = inputs->machines[index];
+        for (; event < inputs->eventCount && inputs->eventMachines[event] == machine; ++event)
+        {
+            DetermDataEvent* copy = new DetermDataEvent((DetermDataEvent*)inputs->events[event]);
+            Function<DetermDataEvent*> disposer(FreeDetermDataEvent);
+            sDetermDataEventQueue.Queue(copy, disposer);
+        }
+        NetworkPeer* peer = g_pNetworkSessionBase->GetPeer(machine);
+        for (s8 player = 0; player < inputs->players[machine]; ++player)
+        {
+            s8 playerId = GetNetworkPlayerId(player, machine);
+            peer->GetNetworkPeerChannel(player)->ApplyNetworkPeerChannelInput(
+                (const PackedDetInput*)inputs->records[playerId], inputs->remapAngles[machine],
+                inputs->states[playerId]);
+        }
+    }
+}
+#endif
+
 void InitializeInputRouters()
 {
     gSimpleInputRouter = new SimpleInputRouter;
