+#if defined(MSCHARGED_TWEAKS)
+// One fixed step exactly as Run's loop makes it (pads, inputs, simulation),
+// for the sync test to run and replay: 0 when no simulation step ran, 1 when
+// one did, -1 when one did and a NIS now stops the simulation.
+static int SyncTestStep()
+{
+    g_pPadManager->SetActivePadSet(1);
+    UpdatePlatPad(g_pPlatPadManager);
+    g_pPadManager->Update(g_fFixedUpdateTick);
+    FlickDetection::Update();
+
+    int updateCount = gInputManager->GetUpdateCount();
+    gInputManager->CaptureInputs();
+
+    int result = 0;
+    for (int i = 0; i < updateCount; ++i)
+    {
+        if (gInputManager->PrepareUpdate())
+        {
+            fixedUpdateTask.CallFixedUpdateTasks();
+            result = 1;
+        }
+        if (IsNisLoadedOnAllMachines(GetPresentation()))
+        {
+            return result ? -1 : 0;
+        }
+    }
+    return result;
+}
+
+// The game's own checksum of the match.
+static unsigned MatchChecksum()
+{
+    return fixedUpdateTask.CalculateChecksum();
+}
